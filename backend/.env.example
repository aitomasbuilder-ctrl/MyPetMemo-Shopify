# Copy to your host's environment settings (Vercel -> Project -> Settings -> Environment Variables). NEVER commit real values.
PRINTIFY_TOKEN=            # Printify personal access token (orders.write, shops.read, products.read, catalog.read)
PRINTIFY_SHOP_ID=29091709
PRINTIFY_MODE=draft        # keep "draft" until you have approved a real test order; "production" sends to production
SHOPIFY_SHOP_DOMAIN=       # yourstore.myshopify.com
SHOPIFY_CLIENT_ID=         # Dev Dashboard app -> Settings -> Client ID
SHOPIFY_CLIENT_SECRET=     # Dev Dashboard app -> Settings -> Client secret (also used as the webhook signing secret if the webhook is created by the app)
# SHOPIFY_ADMIN_TOKEN=     # only for a legacy custom app with a static token (then the two lines above are not needed)
SHOPIFY_WEBHOOK_SECRET=    # signing secret of the custom app (used to verify orders/paid webhooks)

# --- Pet studio (personalized blankets) ---
DESIGN_SIGNING_SECRET=     # random string, 32+ characters (e.g. `openssl rand -hex 32`). Signs approved designs; changing it invalidates designs in open carts.
ADMIN_API_SECRET=          # random string, 24+ characters. Bearer token for POST /api/fulfillment-retry.
# BLOB_READ_WRITE_TOKEN=   # added automatically when you connect a Vercel Blob store to the project (stores the print files Printify downloads)
# STOREFRONT_ORIGINS=https://mypetmemo.com,https://www.mypetmemo.com   # origins allowed to call /api/designs and /api/print-template
# ALLOWED_ASSET_HOSTS=cdn.shopify.com,mypetmemo.com,www.mypetmemo.com  # hosts that artwork and background images may be downloaded from
# DESIGN_APPROVALS_PER_HOUR=120                                         # per visitor, best effort
