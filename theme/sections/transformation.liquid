{% capture family %}{% render 'product-kind', item: product, override: section.settings.kind %}{% endcapture %}{% assign family = family | strip %}{% if family == 'other' %}{% assign family = 'blanket' %}{% endif %}
{% assign source_tile = 2 %}{% if family == 'blanket' %}{% assign source_tile = 6 %}{% endif %}
<section class="section transformation wrap" id="how-it-works"><div class="center section-intro"><p class="eyebrow">{{ 'transform.eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ 'transform.text' | t }}</p></div><div class="transform-grid"><div>{% assign alt = 'transform.photo' | t %}{% render 'pet-image', kind: family, tile: source_tile, alt: alt, sizes: '(max-width: 1000px) 30vw, 320px' %}<div class="stage-caption"><span>01</span><h3>{{ 'transform.photo' | t }}</h3></div></div><span class="transform-arrow">{% render 'icon', name: 'arrow', size: 27 %}</span><div>{% assign alt = 'transform.portrait' | t %}{% render 'pet-image', kind: family, style_index: 1, alt: alt, sizes: '(max-width: 1000px) 30vw, 320px' %}<div class="stage-caption"><span>02</span><h3>{{ 'transform.portrait' | t }}</h3></div></div><span class="transform-arrow">{% render 'icon', name: 'arrow', size: 27 %}</span><div>{% assign alt = 'transform.keepsake' | t %}{% render 'pet-image', kind: family, tile: 0, alt: alt, sizes: '(max-width: 1000px) 30vw, 320px' %}<div class="stage-caption"><span>03</span><h3>{{ 'transform.keepsake' | t }}</h3></div></div></div><div class="center"><a class="button mpm-cta" href="{% if product != blank %}#ProductForm{% else %}{% render 'product-link', kind: family %}{% endif %}">{{ 'transform.start' | t }}</a><p class="small sample-note">{{ 'transform.sample' | t }}</p></div></section>

{% schema %}
{
  "name": "Photo to keepsake",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From your camera roll to your favorite keepsake."
    },
    {
      "type": "select",
      "id": "kind",
      "label": "Example pet",
      "options": [
        {
          "value": "auto",
          "label": "Match product"
        },
        {
          "value": "blanket",
          "label": "Golden retriever"
        },
        {
          "value": "ornament",
          "label": "French bulldog"
        },
        {
          "value": "portrait",
          "label": "Dachshund"
        }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Photo to keepsake"
    }
  ]
}
{% endschema %}
