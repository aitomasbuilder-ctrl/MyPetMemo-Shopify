{% capture family %}{% render 'product-kind', item: product, override: section.settings.kind %}{% endcapture %}{% assign family = family | strip %}{% if family == 'other' %}{% assign family = 'blanket' %}{% endif %}
<section class="section wrap" id="portrait-styles"><div class="section-heading"><div><p class="eyebrow">{{ 'styles.eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2></div><p class="muted">{{ 'styles.intro' | t }}</p></div>{% assign portrait = settings.portrait_product | default: all_products['personalized-pet-portrait'] %}<div class="styles-grid styles-grid--3">{% assign style_keys = 'modern,watercolor,classic' | split: ',' %}{% for style_key in style_keys %}{% assign name_key = 'styles.' | append: style_key %}{% assign name = name_key | t %}{% assign text_key = name_key | append: '_text' %}<a class="style-card" href="{{ portrait.url | default: routes.all_products_collection_url }}?style={{ style_key }}">{% render 'pet-image', kind: family, style_index: forloop.index0, alt: name, sizes: '(max-width: 700px) 92vw, 30vw' %}<div><h3>{{ name }}</h3></div><p>{{ text_key | t }}</p><span class="button mpm-cta">{{ 'styles.choose' | t }}</span></a>{% endfor %}</div></section>

{% schema %}
{
  "name": "Portrait styles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your kind of forever."
    },
    {
      "type": "select",
      "id": "kind",
      "label": "Example pet",
      "options": [
        {
          "value": "auto",
          "label": "Match product"
        },
        {
          "value": "blanket",
          "label": "Golden retriever"
        },
        {
          "value": "ornament",
          "label": "French bulldog"
        },
        {
          "value": "portrait",
          "label": "Dachshund"
        }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Portrait styles"
    }
  ]
}
{% endschema %}
