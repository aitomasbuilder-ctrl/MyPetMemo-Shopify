<section class="section wrap cart-page"><div class="section-heading"><h1>{{ 'cart.title' | t }}</h1><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'cart.keep_shopping' | t }}{% render 'icon', name: 'arrow', size: 17 %}</a></div>
{% if cart.empty? %}<div class="empty-cart">{% render 'icon', name: 'bag', size: 38 %}<h2>{{ 'cart.empty' | t }}</h2><p>{{ 'cart.empty_text' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'catalog.shop_all' | t }}{% render 'icon', name: 'arrow', size: 17 %}</a></div>{% else %}
  <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart-page-layout"><div class="cart-lines">{% for item in cart.items %}{% capture family %}{% render 'product-kind', item: item.product %}{% endcapture %}{% assign family = family | strip %}<article class="cart-item"><div class="cart-item-top"><a class="cart-item-image" href="{{ item.url }}">{% assign design_preview = item.properties['Design preview'] %}{% if design_preview contains '/uploads/' %}<img class="cart-img" src="{{ design_preview | escape }}" alt="{{ item.properties['Design ID'] | default: item.product.title | escape }}" width="240" loading="lazy">{% elsif item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', class: 'cart-img' }}{% elsif family != 'other' %}{% render 'pet-image', kind: family, tile: 0, class: 'cart-img', alt: item.product.title %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'cart-img placeholder' }}{% endif %}</a><div><h2 class="cart-line-title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% render 'cart-properties', item: item %}<div class="cart-controls"><label for="Qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label><input id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric"><a class="text-button" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div>{% for discount in item.line_level_discount_allocations %}<p class="discount-label">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}</div><div class="cart-item-price">{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}<strong>{{ item.final_line_price | money }}</strong></div></div></article>{% endfor %}<button class="button outline update-cart" type="submit" name="update">{{ 'cart.update' | t }}</button><label class="input-label" for="CartNote">{{ 'cart.note' | t }}</label><textarea class="text-input" id="CartNote" name="note" rows="3" maxlength="1000">{{ cart.note | escape }}</textarea></div><aside class="cart-summary"><h2>{{ 'cart.summary' | t }}</h2>{% for discount in cart.cart_level_discount_applications %}<p class="subtotal">{{ discount.title | escape }}<span>−{{ discount.total_allocated_amount | money }}</span></p>{% endfor %}<p class="subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></p><p class="small">{{ 'cart.checkout_note' | t }}</p><button class="button full" type="submit" name="checkout">{{ 'cart.checkout' | t }}{% render 'icon', name: 'arrow', size: 18 %}</button><p class="small">{{ 'cart.personalization_note' | t }}</p></aside></form>
  {% if section.settings.show_addons %}<div class="cart-addons">{% for item in cart.items %}{% if item.properties['_MyPetMemo family'] == 'blanket' or item.properties['_MyPetMemo family'] == 'ornament' %}{% unless item.properties['_MyPetMemo add-on'] %}{% render 'cart-addon', item: item, addon: settings.digital_addon_product, addon_kind: 'portrait', slot: 'digital' %}{% if item.properties['_MyPetMemo family'] == 'blanket' %}{% render 'cart-addon', item: item, addon: settings.ornament_addon_product, addon_kind: 'ornament', slot: 'ornament' %}{% endif %}{% endunless %}{% endif %}{% endfor %}</div>{% endif %}
{% endif %}</section>

{% schema %}
{
  "name": "Shopping bag",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_addons",
      "label": "Show configured add-ons",
      "default": true
    }
  ]
}
{% endschema %}
