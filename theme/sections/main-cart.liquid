<section class="section wrap cart-page"><div class="section-heading"><h1>{{ 'cart.title' | t }}</h1><a class="button mpm-cta" href="{{ routes.all_products_collection_url }}">{{ 'cart.keep_shopping' | t }}</a></div>
{% if cart.empty? %}<div class="empty-cart">{% render 'icon', name: 'bag', size: 38 %}<h2>{{ 'cart.empty' | t }}</h2><p>{{ 'cart.empty_text' | t }}</p><a class="button mpm-cta" href="{{ routes.all_products_collection_url }}">{{ 'catalog.shop_all' | t }}</a></div>{% else %}
  <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart-page-layout"><div class="cart-lines">{% for item in cart.items %}{% capture family %}{% render 'product-kind', item: item.product %}{% endcapture %}{% assign family = family | strip %}<article class="cart-item"><div class="cart-item-top"><a class="cart-item-image" href="{{ item.url }}">{% assign design_preview = item.properties['Design preview'] %}{% if design_preview contains '/uploads/' %}<img class="cart-img" src="{{ design_preview | escape }}" alt="{{ item.properties['Design ID'] | default: item.product.title | escape }}" width="240" loading="lazy">{% elsif item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', class: 'cart-img' }}{% elsif family != 'other' %}{% render 'pet-image', kind: family, tile: 0, class: 'cart-img', alt: item.product.title %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'cart-img placeholder' }}{% endif %}</a><div><h2 class="cart-line-title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{% render 'option-label', value: item.variant.title %}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% render 'cart-properties', item: item %}<div class="cart-controls"><label for="Qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label><input id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric"><a class="text-button" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div>{% for discount in item.line_level_discount_allocations %}{% if discount.amount > 0 %}{% assign discount_title = discount.discount_application.title %}{% if discount_title contains 'Matching set' %}{% assign discount_title = 'cart.discount_matching_set' | t %}{% elsif discount_title contains 'Matching add-on' %}{% assign discount_title = 'cart.discount_matching_addon' | t %}{% endif %}<p class="discount-label">{{ discount_title | escape }} (−{{ discount.amount | money }})</p>{% endif %}{% endfor %}</div><div class="cart-item-price">{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}<strong>{{ item.final_line_price | money }}</strong></div></div></article>{% endfor %}<button class="button outline update-cart" type="submit" name="update">{{ 'cart.update' | t }}</button><label class="input-label" for="CartNote">{{ 'cart.note' | t }}</label><textarea class="text-input" id="CartNote" name="note" rows="3" maxlength="1000">{{ cart.note | escape }}</textarea></div><aside class="cart-summary"><h2>{{ 'cart.summary' | t }}</h2>{% for discount in cart.cart_level_discount_applications %}<p class="subtotal">{{ discount.title | escape }}<span>−{{ discount.total_allocated_amount | money }}</span></p>{% endfor %}<p class="subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></p><p class="small">{{ 'cart.checkout_note' | t }}</p><button class="button full mpm-cta" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>{%- if shop.enabled_payment_types.size > 0 -%}<ul class="cart-payments" aria-label="{{ 'cart.payment_methods' | t }}">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul>{%- endif -%}<p class="small">{{ 'cart.personalization_note' | t }}</p></aside></form>
  {% if section.settings.show_addons %}<div class="cart-addons">{% for item in cart.items %}{% if item.properties['_MyPetMemo family'] == 'blanket' or item.properties['_MyPetMemo family'] == 'ornament' %}{% unless item.properties['_MyPetMemo add-on'] %}{% render 'cart-addon', item: item, addon: settings.digital_addon_product, addon_kind: 'portrait', slot: 'digital' %}{% if item.properties['_MyPetMemo family'] == 'blanket' and section.settings.show_upsell == false %}{% render 'cart-addon', item: item, addon: settings.ornament_addon_product, addon_kind: 'ornament', slot: 'ornament' %}{% endif %}{% endunless %}{% endif %}{% endfor %}</div>{% endif %}
{% if section.settings.show_upsell %}{% assign has_main = false %}{% for item in cart.items %}{% assign f = item.properties['_MyPetMemo family'] %}{% if f == 'blanket' or f == 'portrait' %}{% unless item.properties['_MyPetMemo add-on'] %}{% assign has_main = true %}{% endunless %}{% endif %}{% endfor %}{% if has_main %}{% render 'pet-upsell', s: section.settings %}{% endif %}{% endif %}
{% endif %}</section>

{% schema %}
{
  "name": "Shopping bag",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_addons",
      "label": "Show configured add-ons",
      "default": true
    },
    { "type": "header", "content": "Matching add-on offer (before checkout)" },
    { "type": "paragraph", "content": "Shown when the bag has a personalized blanket or portrait and the shopper clicks Checkout. The ornament and mug are made from the same approved pet artwork. Bundle prices are the automatic discounts in Discounts; keep the percentages below the same." },
    { "type": "checkbox", "id": "show_upsell", "label": "Show matching add-on offer", "default": true },
    { "type": "product", "id": "upsell_ornament", "label": "Ornament", "info": "Default: Custom Pet Christmas Ornament" },
    { "type": "product", "id": "upsell_memorial_ornament", "label": "Ornament for memorial designs", "info": "Default: Pet Memorial Ornament" },
    { "type": "product", "id": "upsell_mug", "label": "Mug", "info": "Default: the product with handle personalized-pet-coffee-mug. Hidden until it exists." },
    { "type": "range", "id": "upsell_percent_one", "label": "Discount for one add-on (%)", "min": 0, "max": 50, "step": 1, "default": 15 },
    { "type": "range", "id": "upsell_percent_both", "label": "Discount when both are added (%)", "min": 0, "max": 50, "step": 1, "default": 20 },
    { "type": "text", "id": "upsell_eyebrow", "label": "Small heading", "default": "Make Your Gift Even More Special ❤️" },
    { "type": "text", "id": "upsell_heading", "label": "Heading", "default": "Complete Your Pet Memory Collection 🐾" },
    { "type": "textarea", "id": "upsell_subheading", "label": "Subheading", "default": "Your pet's portrait is ready. Add a matching keepsake at a special bundle price." },
    { "type": "text", "id": "upsell_ornament_text", "label": "Ornament text", "default": "Ceramic ornament with the same portrait. Ready to hang." },
    { "type": "text", "id": "upsell_mug_text", "label": "Mug text", "default": "11 oz ceramic mug, printed on both sides." },
    { "type": "text", "id": "upsell_skip_label", "label": "Skip button", "default": "No Thanks, Continue to Checkout" },
    { "type": "text", "id": "upsell_continue_label", "label": "Continue button (after adding)", "default": "Continue to Checkout" },
    { "type": "text", "id": "upsell_secure_text", "label": "Note under the button", "default": "Your blanket or portrait stays in your bag either way. Secure checkout." },
    { "type": "text", "id": "upsell_approve_endpoint", "label": "Design approval URL", "default": "https://mypetmemo-shopify.vercel.app/api/designs" },
    { "type": "text", "id": "upsell_template_endpoint", "label": "Printify print-area URL", "default": "https://mypetmemo-shopify.vercel.app/api/print-template" }
  ]
}
{% endschema %}
