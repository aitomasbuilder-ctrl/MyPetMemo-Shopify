<section class="section wrap" id="bestsellers"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'catalog.shop_all' | t }}{% render 'icon', name: 'arrow', size: 17 %}</a></div><div class="product-grid">{% liquid
  assign blankets = section.settings.blanket_collection | default: collections['pet-blankets']
  assign ornaments = section.settings.ornament_collection | default: collections['pet-ornaments']
  assign blanket = blankets.products.first | default: settings.blanket_product | default: all_products['custom-pet-portrait-blanket']
  assign ornament = ornaments.products.first | default: settings.ornament_product | default: all_products['custom-pet-christmas-ornament']
  assign portrait = settings.portrait_product | default: all_products['digital-pet-portrait']
%}{% render 'product-card', item: blanket, kind: 'blanket', category: blankets, sample_images: section.settings.sample_images %}{% render 'product-card', item: ornament, kind: 'ornament', category: ornaments, sample_images: section.settings.sample_images %}{% render 'product-card', item: portrait, kind: 'portrait', sample_images: section.settings.sample_images %}</div></section>

{% schema %}
{
  "name": "Featured keepsakes",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MADE FOR YOUR KIND OF LOVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Their face. Your favorite things."
    },
    {
      "type": "checkbox",
      "id": "sample_images",
      "label": "Use MyPetMemo sample images",
      "default": true
    },
    {
      "type": "collection",
      "id": "blanket_collection",
      "label": "Blanket card opens",
      "info": "Defaults to the pet-blankets collection"
    },
    {
      "type": "collection",
      "id": "ornament_collection",
      "label": "Ornament card opens",
      "info": "Defaults to the pet-ornaments collection"
    }
  ],
  "presets": [
    {
      "name": "Featured keepsakes"
    }
  ]
}
{% endschema %}
