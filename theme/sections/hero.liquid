<section class="hero wrap">
  <div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p>{% liquid
    assign hero_blanket = settings.blanket_product | default: all_products['custom-pet-portrait-blanket']
    assign hero_portrait = settings.portrait_product | default: all_products['personalized-pet-portrait']
  %}<p class="hero-prices">{% render 'portrait-prices', item: hero_portrait, blanket: hero_blanket, key: 'hero.prices' %}</p><p class="hero-preview">{% render 'icon', name: 'check', size: 15 %}{{ 'hero.preview' | t }}</p><div class="hero-buttons"><a class="button mpm-cta" href="{% render 'product-link', kind: 'blanket' %}">{{ 'hero.create_blanket' | t }}</a><a class="button outline mpm-cta mpm-cta--outline" href="{% render 'product-link', kind: 'portrait' %}">{{ 'hero.portrait' | t }}</a></div><div class="trust"><span>{% render 'icon', name: 'heart', size: 15 %}{{ 'hero.trust_1' | t }}</span><span>{% render 'icon', name: 'gift', size: 15 %}{{ 'hero.trust_2' | t }}</span><span>{% render 'icon', name: 'shield', size: 15 %}{{ 'hero.trust_3' | t }}</span></div></div>
  <div class="hero-visual">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(max-width: 700px) 95vw, 50vw', loading: 'eager', fetchpriority: 'high' }}{% else %}<img src="{{ 'hero-960.webp' | asset_url }}" srcset="{{ 'hero-640.webp' | asset_url }} 640w, {{ 'hero-960.webp' | asset_url }} 960w, {{ 'hero-1280.webp' | asset_url }} 1280w, {{ 'hero.webp' | asset_url }} 1536w" sizes="(max-width: 1000px) 100vw, 55vw" width="1536" height="1024" decoding="async" alt=""{{ 'hero.image_alt' | t }}" loading="eager" fetchpriority="high">{% endif %}<div class="hero-note">{% render 'icon', name: 'heart', size: 26 %}<span>{{ 'hero.note' | t }}<br><strong>{{ 'hero.note_bold' | t }}</strong></span></div><span class="image-label">{{ 'common.illustration' | t }}</span></div>
</section>
<div class="values-strip"><span>{{ 'hero.value_1' | t }}</span><i></i><span>{{ 'hero.value_2' | t }}</span><i></i><span>{{ 'hero.value_3' | t }}</span></div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FOR THE PETS WHO ARE FAMILY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turn your favorite pet photo into something forever."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Personalized blankets and portraits, with matching ornaments and mugs. Made from the face you love most."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
