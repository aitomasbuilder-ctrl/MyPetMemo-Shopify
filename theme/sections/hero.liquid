<section class="hero wrap">
  <div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p><div class="hero-buttons"><a class="button mpm-cta" href="{% render 'product-link', kind: 'blanket' %}">{{ 'hero.create' | t }}</a><a class="button outline mpm-cta mpm-cta--outline" href="{% render 'product-link', kind: 'portrait' %}">{{ 'hero.portrait' | t }}</a></div><div class="trust"><span>{% render 'icon', name: 'heart', size: 15 %}{{ 'hero.trust_1' | t }}</span><span>{% render 'icon', name: 'gift', size: 15 %}{{ 'hero.trust_2' | t }}</span><span>{% render 'icon', name: 'shield', size: 15 %}{{ 'hero.trust_3' | t }}</span></div></div>
  <div class="hero-visual">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(max-width: 700px) 95vw, 50vw', loading: 'eager', fetchpriority: 'high' }}{% else %}<img src="{{ 'hero.webp' | asset_url }}" width="1536" height="1024" alt="{{ 'hero.image_alt' | t }}" loading="eager" fetchpriority="high">{% endif %}<div class="hero-note">{% render 'icon', name: 'heart', size: 26 %}<span>{{ 'hero.note' | t }}<br><strong>{{ 'hero.note_bold' | t }}</strong></span></div><span class="image-label">{{ 'common.illustration' | t }}</span></div>
</section>
<div class="values-strip"><span>{{ 'hero.value_1' | t }}</span><i></i><span>{{ 'hero.value_2' | t }}</span><i></i><span>{{ 'hero.value_3' | t }}</span></div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FOR THE PETS WHO ARE FAMILY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turn your favorite pet photo into something forever."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Personalized blankets and portraits, with matching ornaments and mugs. Made from the face you love most."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
