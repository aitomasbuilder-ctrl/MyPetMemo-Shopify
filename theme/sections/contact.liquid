<section class="section wrap contact-page"><div><p class="eyebrow">{{ 'contact.eyebrow' | t }}</p><h1>{{ page.title | default: section.settings.heading | escape }}</h1><p>{{ 'contact.intro' | t }}</p><a class="text-link" href="mailto:{{ settings.support_email | escape }}">{{ settings.support_email | escape }}</a>{% if page.content != blank %}<div class="rte">{{ page.content }}</div>{% endif %}</div>{% form 'contact', id: 'ContactForm' %}{% if form.posted_successfully? %}<p class="success" role="status">{{ 'contact.success' | t }}</p>{% endif %}{% if form.errors %}<div class="error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label class="input-label" for="ContactName">{{ 'contact.name' | t }}</label><input class="text-input" id="ContactName" type="text" name="contact[name]" value="{{ form.name | default: customer.name | escape }}" autocomplete="name" required><label class="input-label" for="ContactEmail">{{ 'contact.email' | t }}</label><input class="text-input" id="ContactEmail" type="email" name="contact[email]" value="{{ form.email | default: customer.email | escape }}" autocomplete="email" required><label class="input-label" for="ContactOrder">{{ 'contact.order' | t }}</label><input class="text-input" id="ContactOrder" type="text" name="contact[Order number]"><label class="input-label" for="ContactMessage">{{ 'contact.message' | t }}</label><textarea class="text-input" id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea><button class="button mpm-cta" type="submit">{{ 'contact.send' | t }}</button>{% endform %}</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let’s talk keepsakes."
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
