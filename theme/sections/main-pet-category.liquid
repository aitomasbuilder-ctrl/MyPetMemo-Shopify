{%- comment -%}
  Category selection page (e.g. /collections/pet-blankets, /collections/pet-ornaments).
  One card per product in the collection: mockup, title, price, sizes or shapes, what can be
  personalized, and a button to the product's personalization page. Prices and availability come
  from Shopify. Optional "Card" blocks override the image, text or feature list for one product.
{%- endcomment -%}
{%- liquid
  assign family = section.settings.family
  if family == 'auto'
    assign family = 'blanket'
    if collection.handle contains 'ornament'
      assign family = 'ornament'
    endif
  endif
  assign noun = section.settings.noun | default: family
  assign count = collection.products_count
-%}
<div class="wrap breadcrumbs"><a href="{{ routes.root_url }}">{{ 'common.home' | t }}</a>{% render 'icon', name: 'chevron', size: 13 %}<span>{{ collection.title | escape }}</span></div>
<section class="wrap collection-hero mpc-hero">
  <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
  <h1>{{ section.settings.heading | default: collection.title | escape }}</h1>
  {%- if collection.description != blank -%}
    <div class="mpc-intro">{{ collection.description }}</div>
  {%- elsif section.settings.intro != blank -%}
    <p class="mpc-intro">{{ section.settings.intro | escape }}</p>
  {%- endif -%}
</section>
{%- if section.settings.show_chips -%}
  <nav class="wrap collection-chips" aria-label="Categories">
    {%- for link in section.settings.chips_menu.links -%}
      <a href="{{ link.url }}"{% if link.url == collection.url %} class="active" aria-current="page"{% endif %}>{{ link.title | escape }}</a>
    {%- else -%}
      {%- assign blankets = collections['pet-blankets'] -%}
      {%- assign ornaments = collections['pet-ornaments'] -%}
      {%- if blankets.products_count > 0 -%}<a href="{{ blankets.url }}"{% if blankets.handle == collection.handle %} class="active" aria-current="page"{% endif %}>Blankets</a>{%- endif -%}
      {%- if ornaments.products_count > 0 -%}<a href="{{ ornaments.url }}"{% if ornaments.handle == collection.handle %} class="active" aria-current="page"{% endif %}>Ornaments</a>{%- endif -%}
    {%- endfor -%}
  </nav>
{%- endif -%}

<section class="wrap collection-products mpc">
  <div class="product-grid{% if count == 2 %} two{% endif %} mpc-grid">
    {%- for item in collection.products -%}
      {%- liquid
        assign card = nil
        for block in section.blocks
          if block.settings.product.id == item.id
            assign card = block
          endif
        endfor
        assign short_title = item.title | split: ' – ' | first | split: ' - ' | first
        assign tagline = item.description | strip_html | strip | split: '.' | first
        assign is_christmas = false
        assign is_memorial = false
        if item.handle contains 'christmas' or item.title contains 'Christmas'
          assign is_christmas = true
        endif
        if item.handle contains 'memorial' or item.title contains 'Memorial'
          assign is_memorial = true
        endif
        assign item_family = family
        if item.type == 'Ornaments' or item.handle contains 'ornament'
          assign item_family = 'ornament'
        elsif item.type == 'Blankets' or item.handle contains 'blanket'
          assign item_family = 'blanket'
        endif
        if item_family == 'ornament'
          if is_memorial
            assign features = 'Soft clouds or watercolor backgrounds|Your pet’s photo, turned into a portrait|Name|Optional dates and a message'
          else
            assign features = 'Festive backgrounds|Your pet’s photo, turned into a portrait|Name|Optional year'
          endif
        else
          if is_christmas
            assign features = 'Christmas and 20+ other backgrounds|Your pet’s photo, turned into a portrait|Name'
          elsif is_memorial
            assign features = 'Soft clouds and 20+ other backgrounds|Your pet’s photo, turned into a portrait|Name'
          else
            assign features = '20+ backgrounds and colors|Your pet’s photo, turned into a portrait|Name'
          endif
        endif
        if card.settings.features != blank
          assign features = card.settings.features | newline_to_br | replace: '<br />', '|'
        endif
        assign feature_list = features | split: '|'
        assign option_name = item.options_with_values.first.name | downcase
      -%}
      <article class="product-card mpc-card" {{ card.shopify_attributes }}>
        <a class="product-image-link mpc-image" href="{{ item.url }}" aria-label="{{ short_title | escape }}">
          {%- if card.settings.image != blank -%}
            {{ card.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400,600,800,1100', sizes: '(max-width: 700px) 92vw, 33vw', class: 'mpc-img', alt: short_title }}
          {%- elsif item.featured_image -%}
            {{ item.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400,600,800,1100', sizes: '(max-width: 700px) 92vw, 33vw', class: 'mpc-img', alt: short_title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'mpc-img placeholder' }}
          {%- endif -%}
          <span class="product-tag">{{ card.settings.tag | default: section.settings.tag | escape }}</span>
          <span class="round-link">{% render 'icon', name: 'arrow-up' %}</span>
        </a>
        <div class="product-card-heading">
          <h2 class="mpc-title"><a href="{{ item.url }}">{{ card.settings.title | default: short_title | escape }}</a></h2>
          <span>{% if item.price_varies %}<small>{{ 'common.from' | t }} </small>{% endif %}{{ item.price | money }}</span>
        </div>
        <p>{{ card.settings.description | default: tagline | escape }}{% if card.settings.description == blank and tagline != blank %}.{% endif %}</p>

        {%- assign values = item.options_with_values.first.values -%}
        {%- if item.has_only_default_variant == false and values.size > 1 -%}
          <div class="mpc-options">
            <p class="mpc-label">{% if option_name contains 'size' or item_family == 'blanket' %}Sizes{% elsif item_family == 'ornament' %}Shapes{% else %}{{ item.options_with_values.first.name | escape }}{% endif %}</p>
            <ul class="mpc-chips">
              {%- for value in values -%}
                {%- assign vprice = nil -%}
                {%- assign vavailable = false -%}
                {%- for variant in item.variants -%}
                  {%- if variant.option1 == value -%}
                    {%- if vprice == nil -%}{%- assign vprice = variant.price -%}{%- endif -%}
                    {%- if variant.available -%}{%- assign vavailable = true -%}{%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                <li{% unless vavailable %} class="is-sold-out"{% endunless %}>{{ value | escape }}{% if item.price_varies and vprice %} · {{ vprice | money }}{% endif %}{% unless vavailable %} · Sold out{% endunless %}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="mpc-options">
          <p class="mpc-label">You personalize</p>
          <ul class="mpc-features">
            {%- for feature in feature_list -%}{%- assign f = feature | strip -%}{%- if f != blank -%}<li>{% render 'icon', name: 'check', size: 15 %}<span>{{ f | escape }}</span></li>{%- endif -%}{%- endfor -%}
          </ul>
        </div>

        {%- if item.available -%}
          <a class="button mpc-button" href="{{ item.url }}">{{ section.settings.button_label | default: 'Personalize' | escape }}{% if section.settings.button_label == blank %} this {{ noun | escape }}{% endif %}{% render 'icon', name: 'arrow', size: 16 %}</a>
        {%- else -%}
          <span class="button outline mpc-button is-disabled" aria-disabled="true">{{ 'catalog.coming_soon' | t }}</span>
        {%- endif -%}
      </article>
    {%- else -%}
      <p>{{ 'collection.empty' | t }}</p>
    {%- endfor -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'coming_soon' -%}
        <article class="product-card mpc-card is-coming-soon" {{ block.shopify_attributes }}>
          <div class="product-image-link mpc-image">
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400,600,800,1100', sizes: '(max-width: 700px) 92vw, 33vw', class: 'mpc-img', alt: block.settings.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'mpc-img placeholder' }}{%- endif -%}
            <span class="product-tag">{{ 'catalog.coming_soon' | t }}</span>
          </div>
          <div class="product-card-heading"><h2 class="mpc-title">{{ block.settings.title | escape }}</h2></div>
          {%- if block.settings.description != blank -%}<p>{{ block.settings.description | escape }}</p>{%- endif -%}
          <p class="small">{{ 'catalog.coming_soon' | t }}</p>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% style %}
  .mpc-hero{padding-bottom:28px}
  .mpc-intro{max-width:620px;color:#8b7551;margin-top:21px;font-size:1rem;line-height:1.75}
  .mpc-intro p{margin:0}
  .mpc-grid{align-items:start}
  .mpc-image{aspect-ratio:1.1;background:#ede7dc}
  .mpc-img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .mpc-image:hover .mpc-img{transform:scale(1.025)}
  .mpc-card .product-card-heading .mpc-title{font:500 1.125rem/1.4 Arial,Helvetica,sans-serif;letter-spacing:0;max-width:none}
  .mpc-card>p{min-height:0}
  .mpc-options{margin-top:18px}
  .mpc-label{font-size:.6875rem;letter-spacing:.12em;text-transform:uppercase;color:#8a7c67;margin-bottom:9px}
  .mpc-chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
  .mpc-chips li{padding:7px 13px;border:1px solid #d4c2a4;border-radius:4px;font-size:.8125rem;line-height:1.4}
  .mpc-chips li.is-sold-out{color:#a99c86;text-decoration:line-through}
  .mpc-features{list-style:none;margin:0;padding:0;display:grid;gap:7px}
  .mpc-features li{display:flex;gap:9px;align-items:flex-start;font-size:.875rem;color:#5f5546;line-height:1.5}
  .mpc-features svg{flex-shrink:0;margin-top:3px;color:#80745f}
  .mpc-button{width:100%;margin-top:24px;justify-content:space-between}
  .mpc-button.is-disabled{background:transparent;color:#8a7c67;border-color:#d4c2a4;justify-content:center;cursor:default}
  .mpc-card.is-coming-soon .mpc-image{opacity:.85}
  @media(max-width:700px){
    .mpc-card .product-card-heading .mpc-title{font-size:1.0625rem}
    .mpc-button{margin-top:20px}
  }
{% endstyle %}

{% schema %}
{
  "name": "Category selection",
  "settings": [
    { "type": "select", "id": "family", "label": "Product type", "default": "auto", "options": [{ "value": "auto", "label": "From the collection" }, { "value": "blanket", "label": "Blankets" }, { "value": "ornament", "label": "Ornaments" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CHOOSE YOUR DESIGN" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Empty: the collection title." },
    { "type": "textarea", "id": "intro", "label": "Intro", "info": "Used when the collection has no description." },
    { "type": "text", "id": "noun", "label": "Product word for the button", "info": "Empty: blanket or ornament." },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Empty: “Personalize this blanket / ornament”." },
    { "type": "text", "id": "tag", "label": "Image tag", "default": "MAKE IT PERSONAL" },
    { "type": "checkbox", "id": "show_chips", "label": "Show category links", "default": true },
    { "type": "link_list", "id": "chips_menu", "label": "Category links menu", "info": "Empty: Blankets and Ornaments." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card override",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Mockup image", "info": "Empty: the product's featured image." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "description", "label": "Short description" },
        { "type": "text", "id": "tag", "label": "Image tag" },
        { "type": "textarea", "id": "features", "label": "What can be personalized", "info": "One per line." }
      ]
    },
    {
      "type": "coming_soon",
      "name": "Coming soon card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "New design" },
        { "type": "text", "id": "description", "label": "Short description" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ]
}
{% endschema %}
