<section class="section wrap password-content"><div><p class="eyebrow">{{ 'password.eyebrow' | t }}</p><h1>{{ section.settings.heading | escape }}</h1>{% if shop.password_message != blank %}<div class="rte">{{ shop.password_message }}</div>{% endif %}<details class="password-login"><summary>{{ 'password.enter' | t }}</summary>{% form 'storefront_password' %}{% if form.errors %}<div class="error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<label class="input-label" for="StorePassword">{{ 'password.password' | t }}</label><input class="text-input" id="StorePassword" type="password" name="password" autocomplete="current-password" required><button class="button mpm-cta" type="submit">{{ 'password.button' | t }}</button>{% endform %}</details></div><div class="password-image"><img src="{{ 'hero.webp' | asset_url }}" width="1536" height="1024" loading="eager" alt="{{ 'hero.image_alt' | t }}"></div></section>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little piece of forever. Coming soon."
    }
  ]
}
{% endschema %}
