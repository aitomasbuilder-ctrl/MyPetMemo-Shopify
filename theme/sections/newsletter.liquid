<section class="newsletter"><div class="wrap newsletter-inner"><div><p class="eyebrow">{{ 'newsletter.eyebrow' | t }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div>{% assign form_id = 'Newsletter-' | append: section.id %}{% form 'customer', id: form_id %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="sr-only" for="Email-{{ section.id }}">{{ 'newsletter.email' | t }}</label><div class="email-field"><input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}"{% if form.errors %} aria-invalid="true"{% endif %}><button class="button mpm-cta" type="submit">{{ section.settings.button | escape }}</button></div><p class="small">{{ 'newsletter.consent' | t }}{% if shop.privacy_policy.body != blank %} <a href="{{ shop.privacy_policy.url }}">{{ 'newsletter.privacy' | t }}</a>{% endif %}</p>{% if form.posted_successfully? %}<p class="success" role="status">{{ 'newsletter.success' | t }}</p>{% endif %}{% if form.errors %}<div class="error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the MyPetMemo family."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Thoughtful pet gift ideas, new keepsakes, and news worth sharing."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "Join the family"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
