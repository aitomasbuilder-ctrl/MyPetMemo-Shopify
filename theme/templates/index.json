    "faq": {
      "type": "faq",
      "blocks": {
        "0": {
          "type": "question",
          "settings": {
            "question": "Which pets are welcome?",
            "answer": "<p>Dogs and cats. Start with a clear photo of one pet with the full face visible.</p>"
          }
        },
        "1": {
          "type": "question",
          "settings": {
            "question": "How does personalization work?",
            "answer": "<p>Upload a pet photo and we turn it into artwork in about a minute. Choose the style, background and name, check the preview, then add it to your cart. We print the exact design you approve.</p>"
          }
        },
        "2": {
          "type": "question",
          "settings": {
            "question": "What makes a great pet photo?",
            "answer": "<p>Bright natural light and a sharp image work best. Keep the camera at your pet’s eye level, with the full face and ears visible. Avoid screenshots, heavy filters, and blurry photos.</p>"
          }
        },
        "3": {
          "type": "question",
          "settings": {
            "question": "What if I have more than one pet?",
            "answer": "<p>Choose a multi-pet option when one is offered on the product page. For a blanket, you can attach a group photo or up to three individual photos. The selected product option determines the price.</p>"
          }
        },
        "4": {
          "type": "question",
          "settings": {
            "question": "Will I see the finished design before I pay?",
            "answer": "<p>Yes. The preview on the product page is the design we print, with your pet, background, name and placement. Colors can look slightly different on fabric, paper or canvas than on a screen.</p>"
          }
        },
        "5": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Each item is made to order: production takes 2–5 business days and delivery usually 3–10 business days, with tracking. The shipping cost is shown at checkout. Digital portraits are emailed after payment. Contact us before ordering if you need a gift by a particular date.</p>"
          }
        },
        "6": {
          "type": "question",
          "settings": {
            "question": "Can I add my pet’s name?",
            "answer": "<p>Yes. Add a name in the personalization form, or leave the field empty for a portrait without a name.</p>"
          }
        },
        "7": {
          "type": "question",
          "settings": {
            "question": "What if I need to change an order?",
            "answer": "<p>Contact us as soon as you notice a mistake and include your order number. Changes depend on whether production has already started.</p>"
          }
        },
        "8": {
          "type": "question",
          "settings": {
            "question": "What if an item arrives damaged or incorrect?",
            "answer": "<p>Contact us with your order number and clear photos. We review production defects, printing issues, and incorrect items under the store’s refund and replacement policy.</p>"
          }
        }
      },
