    "faq": {
      "type": "faq",
      "blocks": {
        "0": {
          "type": "question",
          "settings": {
            "question": "Which pets are welcome?",
            "answer": "<p>Dogs, cats, and the other animals you call family. Use a clear photo with one pet and its full face visible.</p>"
          }
        },
        "1": {
          "type": "question",
          "settings": {
            "question": "How does personalization work?",
            "answer": "<p>Upload a photo of your pet. We turn it into an illustrated portrait with the background removed. Choose a background, add a name and the year, adjust the layout, pick the ornament shape, then approve your preview and add it to your cart.</p>"
          }
        },
        "2": {
          "type": "question",
          "settings": {
            "question": "Will my ornament look like the preview?",
            "answer": "<p>Yes. We print the exact design you approve: the same portrait, background, name and placement. The outline in the preview shows where the ornament ends, so keep your pet and name inside it. Colors can look slightly different on ceramic than on a screen.</p>"
          }
        },
        "3": {
          "type": "question",
          "settings": {
            "question": "What makes a great pet photo?",
            "answer": "<p>Bright, even light and a sharp image work best. Keep the camera at your pet’s eye level with the full face and ears visible, and nothing covering your pet.</p>"
          }
        },
        "4": {
          "type": "question",
          "settings": {
            "question": "Can I change my design after adding it to the cart?",
            "answer": "<p>Yes, until you check out. Edit it on this page and add the new version, then remove the old one from your cart. Each version gets its own design ID.</p>"
          }
        },
        "5": {
          "type": "question",
          "settings": {
            "question": "What if I need to change an order?",
            "answer": "<p>Contact us as soon as you notice a mistake and include your order number. Changes depend on whether production has already started.</p>"
          }
        },
        "6": {
          "type": "question",
          "settings": {
            "question": "What if an item arrives damaged or incorrect?",
            "answer": "<p>Contact us with your order number and clear photos. We review production defects, printing issues, and incorrect items under the store’s refund and replacement policy.</p>"
          }
        },
        "7": {
          "type": "question",
          "settings": {
            "question": "Which shapes can I choose?",
            "answer": "<p>Star, circle, heart and snowflake. The preview changes to the shape you pick, and the design moves to fit it until you adjust it yourself.</p>"
          }
        }
      },
