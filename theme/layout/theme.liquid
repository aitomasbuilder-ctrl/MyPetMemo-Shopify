<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.background }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
  <title>{{ page_title | escape }}{% unless page_title contains shop.name %} · {{ shop.name | escape }}{% endunless %}{% if current_page != 1 %} · {{ current_page }}{% endif %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'shopify.css' | asset_url | stylesheet_tag }}
  {% style %}:root{--background:{{ settings.background }};--foreground:{{ settings.foreground }};--brand-accent:{{ settings.accent }}}{% endstyle %}
  {%- if request.locale.iso_code == 'lt' -%}<script src="{{ 'pet-i18n-lt.js' | asset_url }}" defer="defer"></script>{%- endif -%}
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  <a class="skip" href="#MainContent">{{ 'common.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>
