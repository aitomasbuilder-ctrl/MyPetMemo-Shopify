<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ shop.name | escape }}</title><link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'shopify.css' | asset_url | stylesheet_tag }}{{ 'mpm-cta.css' | asset_url | stylesheet_tag }}{{ content_for_header }}</head><body class="password-page"><a class="skip" href="#MainContent">{{ 'common.skip' | t }}</a><header class="password-header"><a class="wordmark" href="{{ routes.root_url }}">{{ settings.brand_name | escape }}{% render 'icon', name: 'heart', size: 16 %}</a></header><main id="MainContent">{{ content_for_layout }}</main></body></html>
